# CivicPulse Bengaluru Environment Variables
# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# CARTO Basemaps API Key (https://carto.com/developers/maps-api/)
# Required to remove the "API KEY REQUIRED" watermark on the GIS Radar map.
VITE_CARTO_API_KEY=

# Speech-to-Text Transcription Providers (Voice Complaints)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
